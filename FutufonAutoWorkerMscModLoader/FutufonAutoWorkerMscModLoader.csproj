<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{5CC468CB-77F6-200C-363F-3C1A0030EE9B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>FutufonAutoWorkerMscModLoader</RootNamespace>
    <AssemblyName>FutufonAutoWorkerMscModLoader</AssemblyName>
    <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GamePath Condition="'$(GamePath)' == ''">H:\SteamLibrary\steamapps\common\My Winter Car</GamePath>
    <GameManagedPath>$(GamePath)\mywintercar_Data\Managed</GameManagedPath>
    <MSCLoaderPath Condition="'$(MSCLoaderPath)' == '' And Exists('$(GameManagedPath)\MSCLoader.dll')">$(GameManagedPath)\MSCLoader.dll</MSCLoaderPath>
    <MSCLoaderPath Condition="'$(MSCLoaderPath)' == ''">$(MSBuildProjectDirectory)\lib\MSCLoader.dll</MSCLoaderPath>
    <ModsPath Condition="'$(ModsPath)' == ''">$(GamePath)\Mods</ModsPath>
    <DeployMod Condition="'$(DeployMod)' == ''">false</DeployMod>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedPath)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MSCLoader">
      <HintPath>$(MSCLoaderPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(GameManagedPath)\PlayMaker.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="FutufonAutoWorkerMscModLoader.cs" />
    <Compile Include="FactoryDemo.cs" />
    <Compile Include="DemoStepper.cs" />
    <Compile Include="FactoryWorkMonitor.cs" />
    <Compile Include="WorkCheckStatus.cs" />
    <Compile Include="AutomationModel.cs" />
    <Compile Include="WorkerText.cs" />
    <Compile Include="FactoryTelemetry.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="ValidateModReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedPath)\UnityEngine.dll')" Text="UnityEngine.dll not found. Set GamePath to your My Winter Car folder." />
    <Error Condition="!Exists('$(GameManagedPath)\PlayMaker.dll')" Text="PlayMaker.dll not found in the game's Managed folder." />
    <Error Condition="!Exists('$(MSCLoaderPath)')" Text="MSCLoader.dll not found. Install MSCLoader for MWC or set MSCLoaderPath to its MWC reference assembly." />
  </Target>
  <Target Name="DeployModToGame" AfterTargets="Build" Condition="'$(DeployMod)' == 'true'">
    <!-- New loaders may inject MSCLoader.dll at runtime; the build can reference lib/MSCLoader.dll. -->
    <MakeDir Directories="$(ModsPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(ModsPath)" />
  </Target>
</Project>
